# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/book-my-photographer

# Gmail email OTP (use a Google app password)
EMAIL=your-sender-email@gmail.com
EMAIL_PASSWORD=your-google-app-password

# JWT (for future authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1d

# Swagger
SWAGGER_TITLE=Book My Photographer API
SWAGGER_DESCRIPTION=API documentation for Book My Photographer backend
SWAGGER_VERSION=1.0

# MongoDB (for Docker)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE=book-my-photographer
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin